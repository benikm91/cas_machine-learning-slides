ng-template('#slides'='')
    section
        title-page
            h1 Intro
    section
        slide-with-header(header="Über mich").smaller-font
            .row.g-3
                .col-6
                    .row.g-3
                        .col-12
                            .card.h-100.shadow-sm.border-secondary
                                .card-body
                                    h5.text-secondary.mb-3
                                        i.bi.bi-mortarboard-fill.me-2
                                        | Ausbildung
                                    ul.small
                                        li.mb-2
                                            .row
                                                .col-9 #[b Informatiklehre] (mit BM) Applikationsentwickler
                                                .col-3
                                                    img(src="assets/images/about-me/roche.png", width="100%")
                                        li.mb-2
                                            .row
                                                .col-9 #[b Bachelor in Computer Science]
                                                .col-3
                                                    img(src="assets/images/about-me/fhnw.jpg", width="100%")
                                        li.mb-2
                                            .row
                                                .col-9 #[b Master in Computer Science] Vertiefung ML
                                                .col-3
                                                    img(src="assets/images/about-me/unibas.png", width="100%")

                        //- Bottom Left: Experience
                        .col-12
                            .card.h-100.shadow-sm.border-secondary
                                .card-body
                                    h5.text-secondary.mb-3
                                        i.bi.bi-briefcase-fill.me-2
                                        | Berufserfahrung
                                    ul.list-unstyled.small
                                        li.mb-2
                                            .row
                                                .col-9 #[b Data Scientist] bei keeValue, strukturierte Datensätzen
                                                .col-3
                                                    img(src="assets/images/about-me/keevalue.jpg", width="100%")
                                        li.mb-2
                                            .row
                                                .col-9 #[b Wissenschaftlicher Assistent] bei FHNW und ZHAW
                                                .col-3
                                                    img(src="assets/images/about-me/zhaw.jpg", width="100%")
                .col-6
                    .card.h-100.shadow-lg.bg-light
                        .card-body
                            h5.text-dark.mb-3
                                i.bi.bi-search.me-2
                                | Aktuelle Forschung
                            ul.list-unstyled.small
                                li.mb-2
                                    div #[b PhD Candidate] an der UZH und an der ZHAW im CAI (Center for AI)
                                    div Fokus auf Applied Science, grosse Datensätze, Deep Learning, Strukturen
                                    img(src="assets/images/about-me/document-recognition-as-transcription.png", width="100%")
                                    .row
                                        .col-6
                                            img(src="assets/images/about-me/domain-injection.png", width="100%")
                                        .col-6
                                            img(src="assets/images/about-me/echo.png", width="100%")
                                li.mb-2
                                    div #[b Side-Quest] DimWit und DeepWit für Verständnis durch Code (Scala)
    section
        slide-with-header(header="4 Tage Machine Learning")
            .row.mt-3
                .col-4.text-start
                    b Tag 1
                .col-8.text-start Einführung, Regression, Gradient Descent, Feature Preprocessing & Engineering
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    b Tag 2
                .col-8.text-start Klassifikation, weitere Algorithmen
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    b Tag 3
                .col-8.text-start Dimensionality Reduction, Neural Network
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    b Tag 4
                .col-8.text-start Deep Learning, In-Context Learning
    section
        slide-with-header(header="Programmieren! Programmieren! Programmieren!")
            img(src="assets/images/code.png")
            .row.mt-3
                .col-4.text-start
                    b Code-Beispiele
                .col-8.text-start Fertiges minimales #[span.highlight Beispiel]
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    b Übungen
                .col-8.text-start Gelerntes an #[span.highlight einfachem Problemfall] selbst anzuwenden
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    b ML-Lab
                .col-8.text-start Gelerntes an #[span.highlight echtem Problemfall] selbst anwenden
    section
        slide-with-header(header="Programmieren! Programmieren! Programmieren!")
            img(src="assets/images/code-used-frameworks.png")
    section
        slide-with-header(header="Über die Slides")
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    .d-flex.justify-center.align-center.h-100.w-100
                        img(src="assets/images/layout/extra-stamp.png").img-fluid
                .col-8.text-start Slide behandelt fortgeschrittenes Thema. Sollte (!) nicht an der Prüfung kommen.
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    .d-flex.justify-center.align-center.h-100.w-100
                        img(src="assets/images/code.png").img-fluid
                .col-8.text-start Slide verweist auf Code-Beispiel
            .row.mt-3.border-top.pt-3
                .col-4.text-start
                    .d-flex.justify-center.align-center.h-100.w-100
                        img(src="assets/images/github.png").img-fluid
                .col-8.text-start https://github.com/benikm91/cas_machine-learning-slides
