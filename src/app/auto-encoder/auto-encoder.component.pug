ng-template('#slides'='')
    tables-of-content-auto-encoder([active]="autoEncoderLabel.AUTO_ENCODER")
        div.fragment.alert.alert-primary.mt-5 Auto Encoder lernt eine&nbsp;
            a(href="#/{{dimensionalityReductionLabel.href}}").highlight Dimensionality Reduction.
    section
        slide-with-header(header="Auto Encoder - Motivation")
            ul
                li #[span.highlight Nicht-lineare Dimensionality Reduction] anhand von Daten lernen.
                li.fragment Wir verwenden ein Neural Network und den #[span.highlight Reconstruction Error] als Kostenfunktion.
                li.fragment #[span.highlight Undercomplete Autoencoder]: #[span.highlight Bottleneck] in der Architektur vom Netzwerk
                li.fragment (Overcomplete Autoencoder: Kein Bottleneck aber Regularization)
    tables-of-content-auto-encoder([active]="autoEncoderLabel.DATA_SPECIFICATION")
    section
        slide-with-header(header="Auto Encoder - Data Specification")
            ol
                li.fragment Welche #[span.highlight Features] haben wir, z.B. #[span.code-font pixel]
                li.fragment
                    data-specification-element-categorical-feature-encoded
                li.fragment
                    data-specification-element-numerical-feature-standardize
    tables-of-content-auto-encoder([active]="autoEncoderLabel.MODEL")
    section
        slide-with-header(header="Auto Encoder - Model")
            div.text-center
                img(src="assets/images/auto-encoder/auto-encoder-motivation.png", height="300px" alt="Auto Encoder")
            div.mt-3 &nbsp;
            div.mt-5.fragment
                model-3-visualization().mt-5
                    div(inputHeader)
                        div(style={marginTop: "-75px"})
                            h5(style={marginBottom: "0"}) Input Space
                            h6(margin="0") 3072 Features
                    div(featureHeader)
                        div(style={marginTop: "-50px"})
                            h5(style={marginBottom: "0"}) Latent Space
                            h6(margin="0") 200 Features
                    div(outputHeader)
                        div(style={marginTop: "-100px"})
                            h5(style={marginBottom: "0"}) Reconstructed Input Space
                            h6(margin="0") 3072 Features
                    div(input).rect-styling
                        img(src="assets/images/pca/example-img.png")
                    div(pre).model-box.code
                        div Encoder
                    div(feature).fix-height.code
                        div [ -57.2, -3.6, ..., 2.3, -3.4 ]
                    div(model).model-box.code
                        div Decoder
                    div(output).rect-styling
                        img(src="assets/images/pca/example-img-reconstruction.png")
    section
        slide-with-header(header="Auto Encoder - Model - Beispielsweise für CIFAR")
            div.text-center
                img(src="assets/images/auto-encoder/auto_encoder_cifar10.png", height="350px", alt="Auto Encoder")
            div.fragment.mt-5.alert.alert-primary Hier Reduktion von #[span.highlight 3072] auf #[span.highlight 200] Dimensionen.
            div.fragment.mt-3.alert.alert-warning Genaue Architektur ist "Hyper Parameter"
    tables-of-content-auto-encoder([active]="autoEncoderLabel.COST_FUNCTION")
    section
        slide-with-header(header="Auto Encoder - Kostenfunktion")
            div([mathjax]="costFunction")
            div.fragment.mt-5.alert.alert-primary Ander Kostenfunktionen möglich, z.B. #[span.highlight L1] Distanz.
    tables-of-content-auto-encoder([active]="autoEncoderLabel.OPTIMIERUNG")
        div.mt-5.fragment.text-center.alert.alert-primary Gradient Descent
    section
        slide-with-header(header="Auto Encoder - Einsatzgebiete", [extra]="true")
            ul
                li Als #[span.highlight Dimensionsreduktion] für Klassifikation
                li Als #[span.highlight Dimensionsreduktion] für Clustering
                li.fragment Rekonstruktionsfehler verwenden für Anomalieerkennung (#[a(href="https://digitalcollection.zhaw.ch/server/api/core/bitstreams/79be6810-ec57-46e4-8cfd-39a421e31483/content") Paper])
                li.fragment Rekonstruktion für Domain Adaptation (#[a(href="https://digitalcollection.zhaw.ch/server/api/core/bitstreams/e918e723-d2d1-4ef4-96c7-0226ce624734/content") Paper])
    section
        slide-with-header(header="Auto Encoder - Limits", [extra]="true")
            div.row
                div.col-5.offset-1
                    h6 Possible
                div.col-5
                    h6 Impossible (in Feature Space)
                div.col-1
            div.row
                div.col-1.m-auto
                    h6(style={transform: "rotate(-90deg)", whiteSpace: 'nowrap', marginBottom: "-300px"}) 2 Features zu 1
                div.col-5.p-2
                    img(src="assets/images/pca/example-data-with-model-2d-possible.png").limit-possible
                div.col-5.p-2
                    img(src="assets/images/pca/example-data-with-model-2d-limit.png").limit-possible
                div.col-1
            div.row
                div.col-1.m-auto
                    h6(style={
                        transform: "rotate(-90deg)",
                        whiteSpace: 'nowrap',
                        marginBottom: "-300px"
                    }) 3 Features zu 2
                div.col-5.p-2
                    img(src="assets/images/pca/pca-limit-3d.png").limit-possible
                div.col-5.p-2
                    img(src="assets/images/pca/pca-limit-3d-isomap.png").limit-possible
                div.col-1
            div.mt-2.text-center.alert.alert-primary
                .row
                    .col-12 Auto Encoder lernt #[span.highlight nicht-lineares] Manifold im Feature-Space
    section
        slide-with-header(header="Auto Encoder - Limits", [extra]="true")
            .row 
                .col-12
                    ul
                        li #[span.highlight Reconstruction Error] nicht optimal für z.B. Bilder.
                        li Gelernte Repräsentation beinhaltet viel #[span.highlight pixel-perfekte] Information anstatt semantische Informationen.
                .col-8
                    ul.small
                        li "Reconstruction-based methods applied on images are misaligned, ill-conditioned, and ill-posed" 
                                br
                                a(href="https://arxiv.org/abs/2402.11337", style={fontSize: "9pt", marginTop: "-25px"}) Source: Learning by Reconstruction Produces Uninformative Features For Perception"
                .col-4 
                    img(src="assets/images/auto-encoder/tree.gif")

    section
        slide-with-header(header="Auto Encoder vs. PCA")
            div Wenn Encoder und Decoder #[span.highlight linear] sind (z.B. lineare #[a(href="#/activation-function") Aktivierungsfunktion]), dann lernt der Auto Encoder den #[span.highlight gleichen Latent Space wie #[a.highlight(href="#/Principal Component Analysis") PCA]].

    question-slide([questions]="[]")
