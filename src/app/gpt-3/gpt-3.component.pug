ng-template('#slides'='')
    section(id="llm")
        slide-with-header(header="Was ist ein Large Language Model (LLM)?")
            div.llm-prediction
                div.llm-input.code
                    | Die Katze jagt die
                    span.highlight  ?
                div.llm-arrow &rarr;
                div.llm-model.model-box
                    div LLM
                    div.small Riesiges Neurales Netz
                div.llm-arrow &rarr;
                div.llm-output.code
                    div.llm-prob
                        span.llm-bar(style={width: "128px"})
                        span Maus 64%
                    div.llm-prob
                        span.llm-bar(style={width: "36px"})
                        span Vögel 18%
                    div.llm-prob
                        span.llm-bar(style={width: "10px"})
                        span Fliege 5%
                    div.llm-prob
                        span ...
            ul.smaller-font.mt-4
                li Aufgabe: #[span.highlight Nächstes Wort vorhersagen] (next-word prediction)
                li.fragment Das ist #[span.highlight Klassifikation]: Jedes mögliche Wort ist eine Klasse (Softmax wie bei #[a(href="#/{{logisticRegressionHref}}") Logistischer Regression])
                li.fragment #[span.highlight Autoregressiv:] Vorhergesagtes Wort anhängen und wieder vorhersagen &rarr; so entsteht Wort für Wort ein Text
            div.fragment.text-center.alert.alert-warning.p-2.mt-3(style={fontSize: "20pt"})
                | Genauer: Vorhergesagt werden #[span.highlight Tokens] (Teil-Wörter, Ziffern, Satzzeichen, ...), z.B.
                span.code.ms-2 Dimension|s|reduktion
                br
                | Darum: #[span.highlight next-token prediction] mit ca. 100'000 Klassen
    section
        slide-with-header(header="Warum next-token prediction?")
            div.smaller-font.text-start Um das nächste Token gut vorherzusagen, braucht es ganz unterschiedliche #[span.highlight Fähigkeiten]:
            div.next-token-examples.mt-3
                div.row.fragment
                    div.col-8.code Gestern bin ich nach Hause #[span.highlight gegangen]
                    div.col-4 Sprache und Grammatik
                div.row.fragment
                    div.col-8.code Die Hauptstadt der Schweiz ist #[span.highlight Bern]
                    div.col-4 Faktenwissen
                div.row.fragment
                    div.col-8.code Für Pfannkuchen braucht man Mehl, Milch und #[span.highlight Eier]
                    div.col-4 Alltagswissen
                div.row.fragment
                    div.col-8.code 12 + 30 = #[span.highlight 42]
                    div.col-4 Rechnen
                div.row.fragment
                    div.col-8.code def add(a, b): return #[span.highlight a + b]
                    div.col-4 Programmieren
                div.row.fragment
                    div.col-8.code [... ganzer Krimi ...] Der Mörder war #[span.highlight der Gärtner]
                    div.col-4 Textverständnis
            div.fragment.text-center.alert.alert-primary.p-2.mt-3(style={fontSize: "20pt"})
                | #[span.highlight Keine Labels nötig:] Jeder Text liefert seine Labels selbst (vgl. #[a(href="#/word2vec-what-it-learned/0") Word2Vec])
            div.fragment.text-center.alert.alert-warning.p-2.mt-2(style={fontSize: "20pt"})
                | Eine einzige, simple Aufgabe führt zu #[span.highlight generellen, emergenten Fähigkeiten]
    section(id="icl-idea")
        slide-with-header(header="In-Context Learning (ICL) - Idee")
            div(style={fontSize: "32px"})
                ul
                    li Ein LLM kann nur eines: #[span.highlight Text fortsetzen] (next-token prediction)
                    li.fragment Idee: Die Aufgabe so als Text schreiben (#[span.highlight Prompt]), dass die Fortsetzung die Lösung ist
                    li.fragment Überraschung: Das Modell #[span.highlight löst so neue Aufgaben ohne Training]
                    li.fragment Das nennt man #[span.highlight In-Context Learning]: Alles, was das Modell über die Aufgabe weiss, steht im Kontext (= Input vom Modell)
    section(id="icl-example")
        slide-with-header(header="ICL - Beispiel: Spam-Erkennung (zero-shot)")
            div.prompt-box
                div.task-text Klassifiziere die E-Mail als Spam oder Kein Spam.
                div.mt-3.input-text E-Mail: Letzte Mahnung: Ihr Paket wartet. Bezahlen Sie jetzt 1.99 CHF Zollgebühr.
                div.input-text Klasse:
                    span.fragment.llm-text(data-fragment-index="0")  Spam
            div.reference.mt-2
                | #[span.task-text Aufgabe], #[span.input-text Input]#[span.fragment(data-fragment-index="0") , #[span.llm-text Antwort vom LLM]]
    section(id="icl-example-few-shot")
        slide-with-header(header="ICL - Beispiel: Spam-Erkennung (few-shot)")
            div.prompt-box
                div.task-text Klassifiziere die E-Mail als Spam oder Kein Spam.
                div.mt-2.example-text E-Mail: Sie haben gewonnen! Klicken Sie hier, um Ihren Preis von 1'000'000 CHF abzuholen.
                div.example-text Klasse: Spam
                div.mt-2.example-text E-Mail: Hoi Benjamin, die Folien für Tag 4 sind im Anhang. Gruss, Anna
                div.example-text Klasse: Kein Spam
                div.mt-2.input-text E-Mail: Letzte Mahnung: Ihr Paket wartet. Bezahlen Sie jetzt 1.99 CHF Zollgebühr.
                div.input-text Klasse:
                    span.fragment.llm-text(data-fragment-index="0")  Spam
            div.reference.mt-2
                | #[span.task-text Aufgabe], #[span.example-text Beispiele], #[span.input-text Input]#[span.fragment(data-fragment-index="0") , #[span.llm-text Antwort vom LLM]]
    section(id="in-context-learning")
        slide-with-header(header="Was ist In-Context Learning")
            ul.smaller-font
                li Paradigmenwechsel
                    ul
                        li #[span.highlight Kein Training] (fit) bzw. keine Anpassung der Parameter
                        li Modell "lernt" selbst #[span.highlight während der Vorhersage] vom nächsten Token
                        li Vergleich zu bisher: Kein Datensatz, kein Feature Engineering, kein fit
                li.fragment #[span.highlight Zero-shot:] Nur die Aufgabe beschreiben, keine Beispiele
                li.fragment #[span.highlight Few-shot:] Aufgabe und wenige Beispiele. Eigene Regeln (was ist für #[span.highlight mich] Spam?) "lernt" das Modell aus den Beispielen
                li.fragment #[span.highlight Prompt Engineering:] Prompt dem Modell anpassen damit es besser funktioniert
                    ul
                        li Wie Aufgabe und Beispiele wählen? &rarr; #[a.highlight(href="#/{{crossValidationHref}}") Validation Set] zum Testen
    section(id="icl-example-floorplans")
        slide-with-header(header="ICL - Beispiel: Grundrisse lesen", [extra]="true")
            div.small-font.text-start Aufgabe: Aus der Zeichnung alle Wände, Türen und Fenster als Liniensegmente herauslesen
            div.row.floorplan-header.mt-2.mx-auto(style={width: "90%"})
                div.col-3 Input (Zeichnung)
                div.col-3 Wahrheit
                div.col-3 #[span.highlight ICL:] 1 Beispiel, kein Training
                div.col-3 #[span.highlight Trainiert:] Spezial-Modell
            img(src="assets/images/gpt-3/icl-floorplans.png", width="90%")
            img(src="assets/images/gpt-3/icl-floorplans-legend.png", width="70%")
            ul.small-font
                li.fragment ICL (one-shot mit einem Vision Language Model): findet #[span.highlight 94%] der Elemente, aber nur #[span.highlight 1 von 10] Plänen ist exakt richtig
                li.fragment Trainiertes Modell (11 Mio. Parameter): #[span.highlight 9 von 10] Plänen exakt richtig
            div.fragment.text-center.alert.alert-primary.p-2.mt-2(style={fontSize: "18pt"})
                | ICL: #[span.highlight Schnell] zu einer brauchbaren Lösung. Verbesserung möglich.
            div.fragment.text-center.alert.alert-warning.p-2.mt-2(style={fontSize: "18pt"})
                | Aber #[span.highlight externe Abhängigkeit] (bei Claude) und #[span.highlight Inferenz-Kosten].
    question-slide([questions]="[]")
    section(id="rag")
        slide-with-header(header="ICL - RAG - Grundidee", [extra]="true")
            .row
                .col-6
                    div.rag-diagram
                        div.rag-box.rag-question.fragment(data-fragment-index="0") Frage vom Benutzer
                        div.rag-arrow.fragment(data-fragment-index="1") &darr; #[span.highlight 1. Suchen]
                        div.rag-box
                            div.rag-title Spesenreglement, zerlegt in Textstellen
                            div.rag-chunks
                                div.rag-chunk §1
                                div.rag-chunk §2
                                div.rag-chunk.fragment.rag-hit(data-fragment-index="1") §3
                                div.rag-chunk.fragment.rag-hit(data-fragment-index="1") §4
                                div.rag-chunk §5
                                div.rag-chunk §6
                                div.rag-chunk §7
                                div.rag-chunk §8
                                div.rag-chunk §9
                                div.rag-chunk §10
                        div.rag-arrow.fragment(data-fragment-index="2") &darr; #[span.highlight 2. Einfügen]
                        div.rag-box
                            div.rag-title Kontext (Prompt)
                            div.rag-chunks
                                div.rag-chip.rag-chip-task Aufgabe
                                div.rag-chip.rag-chip-example.fragment(data-fragment-index="2") Textstellen §3, §4
                                div.rag-chip.rag-chip-input.fragment(data-fragment-index="0") Frage
                        div.rag-arrow.fragment(data-fragment-index="3") &darr; #[span.highlight 3. Antworten]
                        div.rag-llm.model-box.fragment(data-fragment-index="3") LLM
                .col-6
                    div.prompt-box.rag-prompt
                        div.task-text Beantworte die Frage zum Spesenreglement unserer Firma. Verwende nur die folgenden Textstellen aus dem Reglement.
                        div.fragment(data-fragment-index="2")
                            div.mt-2.example-text §3: Zugreisen werden in der 2. Klasse vergütet.
                            div.example-text §4: Ab 3 Stunden Reisezeit pro Weg wird die 1. Klasse vergütet.
                        div.fragment(data-fragment-index="0")
                            div.mt-2.input-text Frage: Darf ich für die Reise von Brugg nach Genf 1. Klasse buchen?
                            div.input-text Antwort:
                        div.fragment.llm-text(data-fragment-index="3") Nein. Die Reise dauert weniger als 3 Stunden, darum wird die 2. Klasse vergütet (§3 und §4).
                    div.reference.mt-2
                        | #[span.task-text Aufgabe], #[span.example-text gefundene Textstellen], #[span.input-text Frage], #[span.llm-text Antwort vom LLM]
            div.fragment.text-center.alert.alert-primary.p-2.mt-3(data-fragment-index="4", style={fontSize: "20pt"})
                | RAG ist ICL: Statt Beispiele steht das nötige #[span.highlight Wissen im Kontext]
    section(id="rag-summary")
        slide-with-header(header="ICL - RAG - Summary", [extra]="true")
            ul.smaller-font
                li RAG = Retrieval Augmented Generation
                li Idee: Nicht fixe Beispiele, sondern #[span.highlight Wissen basierend auf Anfrage] in den Kontext schreiben
                li #[span.highlight Ziel faktenbasierte Antworten]: Wissen aus Dokumenten nicht (nur) Modell-Parameter. Weniger Halluzination.
                li Was ist RAG: Gezieltes Auffinden relevanter Informationen (#[span.highlight "Needle in the Haystack"]) zur Beantwortung spezifischer Fragen
                li Was ist RAG nicht: Erkennt #[span.highlight keine Trends oder übergeordneter Muster] über den gesamten Datensatz. Informationskette herleiten über mehrere Dokumente um Query zu beantworten.
    section(id="tool-calling")
        slide-with-header(header="ICL - Tool Calling - Grundidee", [extra]="true")
            div.small-font.text-start.mb-3 Idee: Wir geben dem Modell Zugang zu #[span.highlight Tools], z.B. Websuche, Taschenrechner, Bash (Befehle ausführen), Dateien lesen
            .row
                .col-6
                    div.rag-diagram.tool-diagram
                        div.tool-io
                            div.tool-box.tool-box-question Frage vom Benutzer
                            div.tool-box.tool-box-answer.fragment(data-fragment-index="3") Antwort
                        div.tool-io
                            div.tool-step &darr;
                            div.tool-step.fragment(data-fragment-index="3") &uarr; #[span.step-badge 4]
                        div.tool-frame
                            div.tool-llm LLM
                            div.tool-io
                                div.tool-step.fragment(data-fragment-index="0") &darr; #[span.step-badge 1] Tool-Aufruf
                                div.tool-step.fragment(data-fragment-index="2") &uarr; #[span.step-badge.step-badge-green 3] Resultat
                            div.tool-box.tool-box-program Harness (Ablauflogik)
                            div.tool-step.fragment(data-fragment-index="1") &darr; #[span.step-badge 2] Ausführen
                            div.tool-tools
                                div.tool-chip.fragment.tool-chip-hit(data-fragment-index="1") wetter
                                div.tool-chip rechner
                .col-6
                    div.prompt-box.rag-prompt
                        div.task-text Du hast folgende Tools:
                        div.task-text wetter(ort): Aktuelles Wetter
                        div.task-text rechner(ausdruck): Rechnet aus
                        div.task-text Aufruf mit TOOL: name(argument)
                        div.mt-2.input-text Frage: Brauche ich heute in Brugg einen Regenschirm?
                        div.fragment.llm-text(data-fragment-index="0") TOOL: wetter("Brugg")
                        div.fragment.program-text(data-fragment-index="2") RESULTAT: Regen, 8 Grad
                        div.fragment.llm-text(data-fragment-index="3") Antwort: Ja, in Brugg regnet es gerade. Nimm einen Regenschirm mit.
                    div.reference.mt-2
                        | #[span.task-text Tool-Beschreibung], #[span.input-text Frage], #[span.llm-text LLM], #[span.program-text Resultat vom Harness]
            div.fragment.text-center.alert.alert-warning.p-2.mt-3(data-fragment-index="4", style={fontSize: "18pt"})
                | Das LLM führt #[span.highlight nichts] aus. Es schreibt nur Text, den unser Harness erkennt.
            div.fragment.text-center.alert.alert-primary.p-2.mt-2(data-fragment-index="5", style={fontSize: "18pt"})
                | RAG: #[span.highlight Fixer Ablauf]. Tool Calling: #[span.highlight Das Modell entscheidet]. Retrieval kann auch ein Tool sein.
    section(id="tool-calling-demo")
        slide-with-header(header="ICL - Tool Calling - Demo: Websuche", [extra]="true")
            .row
                .col-10
                    div.prompt-box
                        div.task-text Mach mir eine kurze Zusammenfassung der wichtigsten LLM-Neuigkeiten der letzten Woche.
                        div.task-text Suche dazu im Web und gib die Quellen an.
                    ul.smaller-font.mt-5
                        li Welche #[span.highlight Tool-Aufrufe] schreibt das Modell?
                        li Was kommt als #[span.highlight Resultat] zurück in den Kontext?
                .col-2
                    img(src="assets/images/gpt-3/claude.png", width="120px")
    section
        slide-with-header(header="Wie gross ist ein LLM?", [extra]="true")
            table.llm-size-table
                thead
                    tr
                        th Modell
                        th Jahr
                        th Parameter
                        th Trainings-Tokens
                        th Training
                tbody
                    tr
                        td GPT-3
                        td 2020
                        td 175 Mrd.
                        td 300 Mrd.
                        td (ca. 350 GPU-Jahre, V100)
                    tr
                        td GPT-4
                        td 2023
                        td (ca. 1.8 Bio.)
                        td (ca. 13 Bio.)
                        td (ca. 25'000 A100 für 3 Monate)
                    tr
                        td Llama 2 70B
                        td 2023
                        td 70 Mrd.
                        td 2 Bio.
                        td 196 GPU-Jahre, A100
                    tr
                        td Llama 3.1 405B
                        td 2024
                        td 405 Mrd.
                        td 15 Bio.
                        td 3'500 GPU-Jahre, auf 16'000 H100
                    tr
                        td DeepSeek-V3
                        td 2024
                        td 671 Mrd.
                        td 14.8 Bio.
                        td 318 GPU-Jahre, H800
                    tr
                        td GPT-5
                        td 2025
                        td (ca. 100 Mrd. aktiv)
                        td (über 30 Bio.)
                        td (ca. 4'000 GPU-Jahre, H100)
                    tr
                        td GPT-6
                        td 2026
                        td (1 bis 10 Bio.)
                        td -
                        td (über 100'000 GPUs)
            div.reference.mt-2 Werte in (Klammern) sind #[span.highlight Schätzungen], nicht publiziert.
            div.reference
                | Quellen:
                a.ms-1(href="https://arxiv.org/abs/2005.14165") GPT-3
                | ,
                a.ms-1(href="https://arxiv.org/abs/2307.09288") Llama 2
                | ,
                a.ms-1(href="https://huggingface.co/blog/llama31") Llama 3.1
                | ,
                a.ms-1(href="https://arxiv.org/abs/2412.19437") DeepSeek-V3
                | ,
                a.ms-1(href="https://epochai.substack.com/p/notes-on-gpt-5-training-compute") GPT-5 (Epoch AI)
            div.fragment.text-center.alert.alert-warning.p-2.mt-3(style={fontSize: "20pt"})
                | Ein Mensch, der 60 Jahre lang 8 Stunden pro Tag liest, kommt auf ca. #[span.highlight 2.6 Mrd.] Wörter
    section(id="llm-additional-training")
        slide-with-header(header="Ausblick: Vom Base Model zum heutigen LLM", [extra]="true")
            div.llm-timeline
                div.row
                    div.col-2.highlight 2020
                    div.col-3 Base Model
                    div.col-7 Setzt Text fort. Aufgaben lösen nur mit geschicktem Prompt (ICL).
                div.row.fragment
                    div.col-2.highlight 2022
                    div.col-3 Instruct / Chat
                    div.col-7 Zusätzlich trainiert auf Dialogen: Folgt Anweisungen und antwortet als Assistent (ChatGPT).
                div.row.fragment
                    div.col-2.highlight 2023
                    div.col-3 Tool Calling
                    div.col-7 Zusätzlich trainiert, Tool-Aufrufe in einem fixen Format zu schreiben: Zuverlässiger als nur mit Prompt.
                div.row.fragment
                    div.col-2.highlight 2023
                    div.col-3 Multimodal (VLM)
                    div.col-7 Auch Bilder werden zu Tokens (Vision Language Model): Das Modell "sieht" Fotos, Dokumente und Screenshots (vgl. CLIP).
                div.row.fragment
                    div.col-2.highlight 2024
                    div.col-3 Reasoning
                    div.col-7 Zusätzlich trainiert, vor der Antwort Zwischenschritte zu schreiben ("nachdenken").
            div.fragment.text-center.alert.alert-primary.p-2.mt-3(style={fontSize: "20pt"})
                | Muster: Was mit Prompting funktioniert, wird danach #[span.highlight ins Modell trainiert]
            div.fragment.text-center.alert.alert-warning.p-2.mt-2(style={fontSize: "20pt"})
                | Es bleibt alles #[span.highlight next-token prediction] auf einem langen Text
    section(id="llm-limits")
        slide-with-header(header="ICL / LLM - Limits")
            ul.smaller-font
                li #[span.highlight Hallucination:] Faktisch falsche Informationen, oft klingen sie plausibel
                li #[span.highlight Knowledge Cutoff:] Wissenstand veraltet (Training)
                li #[span.highlight Prompt-Abhängigkeit:] Das Resultat ist nur so gut wie Aufgabe und Kontext im Prompt; bei einem Modellwechsel neu testen
                li #[span.highlight Unzuverlässiges Schlussfolgern:] Stark bei bekannten Mustern, aber unerwartete Fehler bei neuen Problemen
                li #[span.highlight Hohe Kosten: ] Cloud-Service vs. Self-Hosting
            div.fragment.text-center.alert.alert-warning.p-2.m-3(style={fontSize: "22pt"})
                | #[span.highlight Verbesserungen sind schwierig:] Oft ist ein Prototyp/Demo einfach, #[br] aber der Weg zu einem Produkt kann schwierig sein.

