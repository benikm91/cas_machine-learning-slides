ng-template('#slides'='')
    section
        slide-with-header(header="\"Language Models are Few-Shot Learners\" (2020)")
            div(style={fontSize: "32px"})
                ul
                    li #[a.highlight(href="https://arxiv.org/abs/2005.14165") Landmark paper] in 2020: GPT-3, #[span.highlight In-Context Learning]
                    li GPT-3 ist ein #[span.highlight LLM (large language model)] oder auch foundation model und das Modell hinter ChatGPT (in 2022), ChatGPT ist GPT-3 angepasst um sich als #[span.highlight Chatbot] zu verhalten
                    li.fragment GPT-3 ist reconstruction-based method, spezifisch, #[span.highlight next-token prediction]; ein Token ist ein Teil-Wort, Ziffer, Satzzeichen, etc.
                    li.fragment Trainieren auf next-token prediction führt zu #[span.highlight überrachenden Fähigkeiten] wie Text-Stimmungs-Neuron, Code-Generierung, Übersetzungsfähigkeiten, ..., (vgl. #[a(href="/#/word2vec-what-it-learned/0") Word2Vec])
                    li.fragment Fähigkeiten erlauben #[span.highlight zero-shot learning und few-shot learning mittels In-Context Learning].
                    li.fragment Grösse: Das kleinere, open-weights #[span.highlight Llama 2] mit #[span.highlight 70 Milliarden Parametern] ist umgerechnet für #[span.highlight 200 Jahre] auf einer A100-80GB GPU trainiert worden auf #[span.highlight Hunderten Milliarden Tokens]
    section
        slide-with-header(header="Was ist In-Context Learning (ICL)")
            img(src="assets/images/gpt-3/in-context-learning.png")
    section
        slide-with-header(header="Was ist In-Context Learning")
            ul
                li Paradigmenwechsel
                ul
                    li #[span.highlight Kein Training] (fit) bzw. keine Anpassung der Parameter
                    li Modell "lernt" selbst #[span.highlight während der Vorhersage] vom nächsten Token
                    li #[span.highlight Prompt engineering]: Prompt dem Modell anpassen damit es besser funktioniert.
    question-slide([questions]="[]")
    section
        slide-with-header(header="ICL - RAG Beispiel - Was ist RAG?", [extra]="true")
            img(src="assets/images/gpt-3/RAG-use-case.png")
    section
        slide-with-header(header="ICL - RAG Beispiel - Was macht RAG?", [extra]="true")
            img(src="assets/images/gpt-3/in-context-learning-RAG.png")
    section
        slide-with-header(header="ICL - RAG - Summary", [extra]="true")
            ul
                li RAG = Retrieval Augmented Generation
                li #[span.highlight Ziel faktenbasierte Antworten]: Wissen aus Dokumenten nicht (nur) Modell-Parameter. Weniger Halluzination.
                li Was ist RAG: Gezieltes Auffinden relevanter Informationen (#[span.highlight "Needle in the Haystack"]) zur Beantwortung spezifischer Fragen
                li Was ist RAG nicht: Erkennt #[span.highlight keine Trends oder übergeordneter Muster] über den gesamten Datensatz. Informationskette herleiten über mehrere Dokumente um Query zu beantworten.
    section
        slide-with-header(header="ICL - Agentic Systems", [extra]="true")
            .row
                .col-6
                    img(src="assets/images/gpt-3/agentic-system.png", width="400px")
                .col-6
                    ul.smaller-font
                        li #[span.highlight Agent:] Vortrainiertes, gepromptes foundation models (LLM, VLM, ...) mit ICL-Fähigkeiten, mit Zugriff auf Tools (und andere Agenten), z.B. um eine Query zu beantworten.
                        li #[span.highlight Ziel:] Erledigung von komplexen Aufgaben. Tools auch für autonome Aktionen.
            div.fragment.mt-5.alert.alert-warning Agentic Systems sind ein aktives Forschungsgebiete
    section
        slide-with-header(header="ICL - Agentic Systems - ACU Beispiel", [extra]="true")
            img(src="assets/images/gpt-3/ACU-use-case.png", width="600px")
            div.mt-3.alert.alert-warning ACU sind ein aktives Forschungsgebiete
    section
        slide-with-header(header="ICL - Agentic Systems - ACU Beispiel", [extra]="true")
            img(src="assets/images/gpt-3/in-context-learning-ACU.png")
            div.mt-5.fragment.alert.alert-warning Prompting ist (Stand heute) Bastelei
    section
        slide-with-header(header="ICL / LLM - Limits")
            ul
                li #[span.highlight Hallucination:] Faktisch falsche Informationen, oft klingen sie plausibel
                li #[span.highlight Knowledge Cutoff:] Wissenstand veraltet (Training)
                li #[span.highlight Prompt Sensitivity:] Formulierung und Struktur des Prompts ist überraschend wichtig
                li #[span.highlight Fehlendes Weltverständnis/Logik:] Kein echtes Verständnis, keine Kausalität oder robustes logisches Schlussfolgern
                li #[span.highlight Hohe Kosten: ] Cloud-Service vs. Self-Hosting
            div.fragment.text-center.alert.alert-warning.p-2.m-3(style={fontSize: "22pt"})
                | #[span.highlight Verbesserung sind schwierig:] Oft ist ein Prototyp/Demo einfach, #[br] aber der Weg zu einem Produkt ist schwierig oder gar unmöglich!

